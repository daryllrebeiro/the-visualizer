{
  "name": "the-visualizer",
  "version": "0.0.1",
  "private": true,
  "description": "Production-grade Kafka distributed systems visualization and simulation platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "dev": "pnpm --recursive --parallel dev",
    "test": "pnpm --filter @the-visualizer/simulation test",
    "test:determinism": "pnpm --filter @the-visualizer/simulation exec vitest run src/golden-determinism.test.ts",
    "test:all": "pnpm --filter @the-visualizer/simulation test && pnpm --filter @the-visualizer/web test",
    "sim": "node scripts/sim-cli.mjs",
    "create:domain": "node scripts/create-domain.mjs",
    "lint": "pnpm --recursive lint",
    "lint:fix": "pnpm --recursive lint:fix",
    "typecheck": "pnpm --recursive typecheck",
    "clean": "rimraf node_modules **/dist **/build **/.next **/coverage **/.turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "axe-core": "^4.13.0",
    "chrome-launcher": "^1.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@11.22.0"
}
