{
  "name": "the-visualizer",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive deterministic simulation, visualization, and chaos engineering platform for 28 distributed systems, AI infrastructure, and algorithms architectures",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm --recursive --parallel dev",
    "test": "vitest run packages/simulation",
    "test:determinism": "vitest run packages/simulation/src/golden-determinism.test.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "test:e2e": "node scripts/run-playwright-e2e.mjs",
    "verify:all": "node scripts/verify-all-18-domains.mjs",
    "benchmark:canvas": "node scripts/benchmark-canvas-fps.mjs",
    "deploy:replit": "node scripts/deploy-replit.mjs",
    "smoke:replit": "node scripts/replit-smoke-test.mjs",
    "replit:start": "node scripts/replit-supervisor.mjs",
    "sim": "node scripts/sim-cli.mjs",
    "sim:golden:update": "node scripts/run-golden-update.mjs",
    "create:domain": "node scripts/create-domain.mjs",
    "lint": "pnpm --recursive lint",
    "lint:fix": "pnpm --recursive lint:fix",
    "typecheck": "pnpm --recursive typecheck",
    "clean": "rimraf node_modules **/dist **/build **/.next **/coverage **/.turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "axe-core": "^4.13.0",
    "chrome-launcher": "^1.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@11.22.0"
}
