{
  "name": "@the-visualizer/api",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless REST API — authentication, authorization, CRUD, and topology management",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --env-file=.env.local dist/index.js",
    "dev:ts": "tsx watch --env-file=.env.local src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist *.tsbuildinfo",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.54.0",
    "@opentelemetry/sdk-node": "^0.57.1",
    "@the-visualizer/config": "workspace:*",
    "@the-visualizer/contracts": "workspace:*",
    "@the-visualizer/logging": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.17",
    "ioredis": "^5.4.1",
    "nanoid": "^5.0.9",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@the-visualizer/test-utils": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.11",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.30.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
