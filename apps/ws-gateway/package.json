{
  "name": "@the-visualizer/ws-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "WebSocket realtime gateway — session management, intent routing, and Redis pub/sub",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@the-visualizer/config": "workspace:*",
    "@the-visualizer/contracts": "workspace:*",
    "@the-visualizer/logging": "workspace:*",
    "@the-visualizer/simulation": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "ioredis": "^5.4.1",
    "msgpackr": "^1.11.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@the-visualizer/test-utils": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^2.1.8",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
