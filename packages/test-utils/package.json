{
  "name": "@the-visualizer/test-utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared test fixtures, factories, and helpers for all workspace packages",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@the-visualizer/contracts": "workspace:*",
    "fast-check": "^3.22.0",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@the-visualizer/contracts": "workspace:*"
  },
  "devDependencies": {
    "@the-visualizer/contracts": "workspace:*",
    "@types/node": "^22.10.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
