{
  "$ref": "#/definitions/topology",
  "definitions": {
    "topology": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "orgId": {
          "type": "string",
          "format": "uuid"
        },
        "createdBy": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "type": "string",
          "enum": ["PRIVATE", "UNLISTED", "PUBLIC"]
        },
        "shareToken": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 32,
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "specVersion": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "definition": {
          "type": "object",
          "additionalProperties": {}
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "orgId",
        "createdBy",
        "name",
        "description",
        "visibility",
        "shareToken",
        "specVersion",
        "definition",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
