              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "INTENT_PRODUCE"
            },
            "topic": {
              "type": "string",
              "minLength": 1,
              "maxLength": 249
            },
            "partition": {
              "type": "integer",
