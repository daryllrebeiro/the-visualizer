            "key": {
              "type": "string",
              "maxLength": 4096
            },
            "value": {
              "type": "string",
              "maxLength": 1048576
            },
            "acks": {
              "type": "number",
              "enum": [0, 1, -1]
            }
          },
          "required": ["id", "type", "topic", "key", "value", "acks"],
          "additionalProperties": false
        },
        {
          "type": "object",
