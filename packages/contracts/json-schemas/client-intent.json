            "groupId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "memberId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "topic": {
              "type": "string",
              "minLength": 1,
              "maxLength": 249
