              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          },
          "required": ["id", "type", "groupId", "memberId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/definitions/client-intent/anyOf/0/properties/id"
            },
            "type": {
              "type": "string",
              "const": "INTENT_COMMIT_OFFSET"
