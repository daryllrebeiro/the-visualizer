{
  "$ref": "#/definitions/server-message",
  "definitions": {
    "server-message": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "MSG_INIT_SNAPSHOT"
            },
            "sessionId": {
              "type": "string",
              "format": "uuid"
            },
            "serverTick": {
              "type": "number",
              "minimum": 0
            },
            "state": {
              "type": "object",
              "additionalProperties": {}
            },
            "sessionConfig": {
              "type": "object",
              "properties": {
                "maxTicks": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "maxBrokers": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "maxPartitions": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "maxProducers": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "maxConsumers": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "maxMsgRatePerSec": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "maxTicks",
                "maxBrokers",
                "maxPartitions",
                "maxProducers",
                "maxConsumers",
                "maxMsgRatePerSec"
              ],
              "additionalProperties": false
            }
          },
          "required": ["type", "sessionId", "serverTick", "state", "sessionConfig"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "MSG_EVENT_BATCH"
            },
            "fromSeq": {
              "type": "number",
              "minimum": 0
            },
            "toSeq": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "serverTick": {
              "type": "number",
              "minimum": 0
            },
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "patches": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": {}
              }
            }
          },
          "required": ["type", "fromSeq", "toSeq", "serverTick", "events", "patches"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "MSG_INTENT_ACK"
            },
            "intentId": {
              "type": "string",
              "format": "uuid"
            },
            "status": {
              "type": "string",
              "enum": ["ACCEPTED", "REJECTED"]
            },
            "reason": {
              "type": "string",
              "maxLength": 500
            }
          },
          "required": ["type", "intentId", "status"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "MSG_INVARIANT_VIOLATION"
            },
            "invariantName": {
              "type": "string"
            },
            "details": {
              "type": "string",
              "maxLength": 2000
            },
            "dumpUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": ["type", "invariantName", "details"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "MSG_PRESENCE_UPDATE"
            },
            "activeUsers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "userId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "cursor": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": ["x", "y"],
                    "additionalProperties": false
                  }
                },
                "required": ["userId", "name"],
                "additionalProperties": false
              }
            }
          },
          "required": ["type", "activeUsers"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "MSG_SESSION_ERROR"
            },
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string",
              "maxLength": 500
            },
            "fatal": {
              "type": "boolean"
            }
          },
          "required": ["type", "code", "message", "fatal"],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
