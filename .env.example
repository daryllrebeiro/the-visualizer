# ─────────────────────────────────────────────────────────────────────────────
# TheVisualizer — Environment Template
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local or any file with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─── API Server ───────────────────────────────────────────────────────────────
API_PORT=3000
WS_GATEWAY_PORT=3001

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://visualizer:visualizer_local@localhost:5432/visualizer_dev

DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redis_local_secret

# ─── Session & Auth ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=REPLACE_WITH_MINIMUM_32_CHAR_RANDOM_SECRET

# OAuth — optional, leave blank to disable
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ─── Object Storage (S3-compatible) ──────────────────────────────────────────
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=the-visualizer-dev
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=the-visualizer-api

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_LIVE_CLUSTER_MODE=false
ENABLE_MULTIPLAYER=false
